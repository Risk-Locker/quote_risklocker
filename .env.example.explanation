# ============================================================================
# Risklocker Quotation Converter — Environment Reference (full explanation)
# ============================================================================
# This is the DETAILED reference for every environment variable the code
# actually reads. For the minimal template you actually copy, use `.env.example`
# (local development) or `.env.production` (production VPS).
#
#   Local dev:      cp .env.example .env
#   Production:     cp .env.production /var/www/html/quote_risklocker/.env
#
# Only the REQUIRED values must be set; everything else has a safe default and
# can be left as-is. The project `.env` is the SOURCE OF TRUTH: the backend
# loads it with override=True (backend/app/core/config.py), so variables
# inherited from the shell can never shadow it. There is deliberately NO
# malware-scanner toggle: the malware scanner is unconditionally required for
# uploads.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. APPLICATION
# ----------------------------------------------------------------------------
# APP_ENV: local | staging | production
# Local development MUST use local (production enforces HTTPS origins, secure
# cookies, and stricter validations that cannot run against localhost HTTP).
APP_ENV=local
APP_NAME=Risklocker Quotation Converter
# Public URL of the frontend (used for cookies, CORS, and security headers).
# Local dev: the frontend dev server prints http://127.0.0.1:3000.
APP_ORIGIN=http://127.0.0.1:3000


# ----------------------------------------------------------------------------
# 2. DATABASE  (Postgres — Supabase or any self-hosted VPS)
# ----------------------------------------------------------------------------
# The app uses ONE Postgres database. To switch DB servers, just change
# DATABASE_URL — nothing else is required.
#
# Supabase endpoints: use the POOLER host (aws-1-ap-southeast-1.pooler.supabase.com)
# — it is reachable over IPv4. The direct host (db.YOUR_PROJECT_REF.supabase.co)
# is IPv6-only and should not be used.
#   Pooler example:
#     postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
#   Self-hosted VPS example:
#     postgresql://risklocker:PASSWORD@127.0.0.1:5432/risklocker
#
# DATABASE_PROVIDER is OPTIONAL and auto-detected from the URL
# (supabase_postgres when the host contains "supabase", otherwise postgres).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# DATABASE_PROVIDER=postgres
# Optional: a separate database used only by the automated test suite
# (only read when APP_ENV=test).
# TEST_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres


# ----------------------------------------------------------------------------
# 3. NETWORK / CORS / TRUST
# ----------------------------------------------------------------------------
# Hosts allowed to reach the backend (comma-separated).
TRUSTED_HOSTS=localhost,127.0.0.1
# IPs of trusted reverse proxies (nginx on the same host -> 127.0.0.1).
TRUSTED_PROXY_IPS=127.0.0.1
# Origins allowed to call the API (must match APP_ORIGIN in production).
# Local dev MUST include every browser origin used: 127.0.0.1:3000 (what
# start-frontend.ps1 prints) and localhost:3000; add the API origin
# (http://127.0.0.1:8100) for direct browser testing. A POST whose Origin is
# missing from this list returns 403 "This request origin is not allowed."
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8100


# ----------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSIONS
# ----------------------------------------------------------------------------
# REQUIRED. Long random string used to sign auth hashes.
# In production it must not be a placeholder and must be >= 32 characters.
AUTH_HASH_SECRET=local-development-change-me
# Must be true in production (HTTPS only). Defaults to (APP_ENV == production).
SESSION_COOKIE_SECURE=false
# Cookie names must match the FRONTEND: the Next.js middleware
# (frontend/src/middleware.ts) reads SESSION_COOKIE_NAME too.
SESSION_COOKIE_NAME=risklocker_session
CSRF_COOKIE_NAME=risklocker_csrf
# Fixed values — do not change (enforced by the backend):
# SESSION_IDLE_HOURS=8
# SESSION_MAX_DAYS=30


# ----------------------------------------------------------------------------
# 5. PDF STORAGE  (Supabase Storage — private bucket)
# ----------------------------------------------------------------------------
# PDFs and asset images are stored in a private Supabase Storage bucket.
# PDFs always live in the SAME Supabase project as the database.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=risklocker-pdfs


# ----------------------------------------------------------------------------
# 6. UPLOAD & PROCESSING LIMITS
# ----------------------------------------------------------------------------
# Exactly one PDF per upload (v7 contract — do not change).
MAX_UPLOAD_FILES=1
# Maximum source PDF size in bytes (20 MB).
MAX_SOURCE_PDF_BYTES=20971520
# Legacy alias for the source PDF limit when MAX_SOURCE_PDF_BYTES is unset.
# MAX_UPLOAD_BYTES=20971520
# Maximum number of pages in a source PDF.
MAX_PDF_PAGES=100
# Maximum generated PDF size in bytes (25 MB).
MAX_GENERATED_PDF_BYTES=26214400
# Maximum asset image size in bytes (10 MB) and pixels (32 MP).
MAX_ASSET_BYTES=10485760
MAX_ASSET_PIXELS=32000000
# Catalog import limits.
MAX_CATALOG_IMPORT_BYTES=5242880
MAX_CATALOG_IMPORT_ROWS=5000
# Template JSON limits.
MAX_TEMPLATE_JSON_BYTES=2097152
MAX_TEMPLATE_ELEMENTS=2000
# The malware scanner is ALWAYS required on uploads (no toggle; a scanner must
# be present or uploads refuse with "A malware scanner is required...").


# ----------------------------------------------------------------------------
# 7. RETENTION & TRASH
# ----------------------------------------------------------------------------
PDF_RETENTION_DAYS=30
# Days a trashed item stays in the trash before it can be permanently purged.
TRASH_RETENTION_DAYS=14


# ----------------------------------------------------------------------------
# 8. RATE LIMITS  (per IP)
# ----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_BLOCK_SECONDS=1800
RATE_LIMIT_UPLOAD_ATTEMPTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_PREVIEW_ATTEMPTS=30
RATE_LIMIT_PREVIEW_WINDOW_SECONDS=60
RATE_LIMIT_GENERATION_ATTEMPTS=10
RATE_LIMIT_GENERATION_WINDOW_SECONDS=3600
RATE_LIMIT_DOWNLOAD_ATTEMPTS=120
RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=60
RATE_LIMIT_IMPORT_ATTEMPTS=5
RATE_LIMIT_IMPORT_WINDOW_SECONDS=3600


# ----------------------------------------------------------------------------
# 9. AI EXTRACTION  (Google Gemini)
# ----------------------------------------------------------------------------
# REQUIRED for AI-assisted PDF extraction. Get a free key from Google AI Studio.
GEMINI_API_KEY=YOUR_FREE_GOOGLE_AI_STUDIO_API_KEY
# Optional: multiple keys for automatic pool rotation (comma-separated).
# GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...
GEMINI_MODEL=gemini-3.1-flash-lite-preview


# ----------------------------------------------------------------------------
# 10. FRONTEND (read by the Next.js server, not the backend)
# ----------------------------------------------------------------------------
# Base origin of the backend for the /api proxy route
# (frontend/src/app/api/[...path]/route.ts). Required when NODE_ENV=production;
# dev mode defaults to http://127.0.0.1:8100. PM2 sets it via ecosystem.config.cjs.
BACKEND_API_ORIGIN=http://127.0.0.1:8100


# ----------------------------------------------------------------------------
# 11. WORKER TOPOLOGY
# ----------------------------------------------------------------------------
# 1 = the API process also runs the embedded job worker (local dev default).
# 0 = jobs are claimed only by the dedicated worker process (production PM2).
ENABLE_EMBEDDED_WORKER=1
# Optional release identifier reported by the worker (deployment bookkeeping).
# RELEASE_ID=


# ----------------------------------------------------------------------------
# REMOVED / DEAD VARIABLES (do NOT restore these — nothing reads them anymore)
# ----------------------------------------------------------------------------
# The following existed in old .env backups but are not consumed by any code:
#   SUPER_ADMIN_EMAIL, SUPER_ADMIN_PASSWORD, SUPABASE_ANON_KEY,
#   SUPABASE_DB_PASSWORD, ENHANCED_READING_ENABLED, OCR_ENABLED, OCR_DEFAULT_MODE,
#   OCR_PROVIDER, LOCAL_OCR_ENGINES, VISION_REVIEW_ENABLED, VISION_PROVIDER,
#   STRICT_NO_GUESSING, SAVE_FULL_EXTRACTION_RECORD, SAVE_RISKLOCKER_DRAFT,
#   REQUIRE_USER_REVIEW_BEFORE_FINAL, GENERATED_PDF_RETENTION_MODE,
#   REQUIRE_MALWARE_SCANNER (scanner is always required now)