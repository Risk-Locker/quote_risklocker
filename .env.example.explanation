# ============================================================================
# Risklocker Quotation Converter — Environment Reference (full explanation)
# ============================================================================
# This is the DETAILED reference for every environment variable.
# For the minimal template you actually copy to `.env`, use `.env.example`.
#
# Copy `.env.example` to `.env` and fill in the values:
#     cp .env.example .env
#
# Sections are grouped by concern. Only the REQUIRED values must be set;
# everything else has a safe default and can be left as-is.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. APPLICATION
# ----------------------------------------------------------------------------
# APP_ENV: local | staging | production
APP_ENV=production
APP_NAME=Risklocker Quotation Converter
# Public URL of the frontend (used for cookies, CORS, and security headers).
APP_ORIGIN=https://YOUR_FRONTEND_HOST


# ----------------------------------------------------------------------------
# 2. DATABASE  (Postgres — Supabase or any self-hosted VPS)
# ----------------------------------------------------------------------------
# The app uses ONE Postgres database. To switch DB servers, just change
# DATABASE_URL — nothing else is required.
#
#   Supabase example:
#     postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#   Self-hosted VPS example:
#     postgresql://risklocker:PASSWORD@127.0.0.1:5432/risklocker
#
# DATABASE_PROVIDER is OPTIONAL and auto-detected from the URL
# (supabase_postgres when the host contains "supabase", otherwise postgres).
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DATABASE_PROVIDER=postgres
# Optional: a separate database used only by the automated test suite.
# TEST_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require


# ----------------------------------------------------------------------------
# 3. NETWORK / CORS / TRUST
# ----------------------------------------------------------------------------
# Hosts allowed to reach the backend (comma-separated).
TRUSTED_HOSTS=YOUR_FRONTEND_HOST
# IPs of trusted reverse proxies (nginx on the same host -> 127.0.0.1).
TRUSTED_PROXY_IPS=10.0.0.2
# Origins allowed to call the API (must match APP_ORIGIN in production).
CORS_ORIGINS=https://YOUR_FRONTEND_HOST


# ----------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSIONS
# ----------------------------------------------------------------------------
# REQUIRED. Long random string used to sign auth hashes. Change in production.
AUTH_HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_NAME=risklocker_session
CSRF_COOKIE_NAME=risklocker_csrf
# Must be true in production (HTTPS only).
SESSION_COOKIE_SECURE=true
# Fixed values — do not change (enforced by the backend).
# SESSION_IDLE_HOURS=8
# SESSION_MAX_DAYS=30


# ----------------------------------------------------------------------------
# 5. PDF STORAGE  (Supabase Storage — private bucket)
# ----------------------------------------------------------------------------
# PDFs and asset images are stored in a private Supabase Storage bucket.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=risklocker-pdfs


# ----------------------------------------------------------------------------
# 6. UPLOAD & PROCESSING LIMITS
# ----------------------------------------------------------------------------
# Exactly one PDF per upload (v7 contract — do not change).
MAX_UPLOAD_FILES=1
# Maximum source PDF size in bytes (20 MB).
MAX_SOURCE_PDF_BYTES=20971520
# Maximum number of pages in a source PDF.
MAX_PDF_PAGES=100
# Maximum generated PDF size in bytes (25 MB).
MAX_GENERATED_PDF_BYTES=26214400
# Maximum asset image size in bytes (10 MB) and pixels (32 MP).
MAX_ASSET_BYTES=10485760
MAX_ASSET_PIXELS=32000000
# Catalog import limits.
MAX_CATALOG_IMPORT_BYTES=5242880
MAX_CATALOG_IMPORT_ROWS=5000
# Template JSON limits.
MAX_TEMPLATE_JSON_BYTES=2097152
MAX_TEMPLATE_ELEMENTS=2000
# Require a malware scanner on uploads (must be true in production).
REQUIRE_MALWARE_SCANNER=true


# ----------------------------------------------------------------------------
# 7. RETENTION & TRASH
# ----------------------------------------------------------------------------
# Days a trashed item stays in the trash before it can be permanently purged.
TRASH_RETENTION_DAYS=14
# Optional: legacy PDF retention window used by migration tooling only.
# PDF_RETENTION_DAYS=30


# ----------------------------------------------------------------------------
# 8. RATE LIMITS  (optional — safe defaults shown)
# ----------------------------------------------------------------------------
# RATE_LIMIT_LOGIN_ATTEMPTS=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_LOGIN_BLOCK_SECONDS=1800
# RATE_LIMIT_UPLOAD_ATTEMPTS=20
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
# RATE_LIMIT_PREVIEW_ATTEMPTS=30
# RATE_LIMIT_PREVIEW_WINDOW_SECONDS=60
# RATE_LIMIT_GENERATION_ATTEMPTS=10
# RATE_LIMIT_GENERATION_WINDOW_SECONDS=3600
# RATE_LIMIT_DOWNLOAD_ATTEMPTS=120
# RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=60
# RATE_LIMIT_IMPORT_ATTEMPTS=5
# RATE_LIMIT_IMPORT_WINDOW_SECONDS=3600


# ----------------------------------------------------------------------------
# 9. AI EXTRACTION  (Google Gemini)
# ----------------------------------------------------------------------------
# REQUIRED for AI-assisted PDF extraction. Get a free key from Google AI Studio.
GEMINI_API_KEY=YOUR_FREE_GOOGLE_AI_STUDIO_API_KEY
# Optional: multiple keys for automatic pool rotation (comma-separated).
# GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...
GEMINI_MODEL=gemini-3.1-flash-lite-preview
