# Next.js server environment (frontend).
# BACKEND_API_ORIGIN: used by the /api proxy route (src/app/api/[...path]/route.ts).
# Required when NODE_ENV=production; dev mode defaults to http://127.0.0.1:8100.
BACKEND_API_ORIGIN=http://127.0.0.1:8100
# Must match the backend's SESSION_COOKIE_NAME (src/middleware.ts reads it). Default: risklocker_session.
SESSION_COOKIE_NAME=risklocker_session
